# ==============================================================================
# Microstock Environment Configuration (.env)
# Salin file ini menjadi .env (di root Microstock atau di microstock-metadata-generator/)
# DILARANG melakukan commit berkas .env asli yang berisi kredensial ke Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY API PROVIDER: Local Gateway / OpenCode (v3 API Backend)
# ------------------------------------------------------------------------------
# API Key untuk local gateway (OpenCode / 127.0.0.1:20128/v1).
# Mendukung 1 key atau multi-key comma-separated untuk round-robin & auto failover:
# Contoh single: MICROSTOCK_API_KEY=your_api_key_here
# Contoh multi : MICROSTOCK_API_KEY=key_alpha,key_beta,key_gamma
MICROSTOCK_API_KEY=your_api_key_here

# Endpoint base URL (default: http://127.0.0.1:20128/v1)
MICROSTOCK_API_ENDPOINT=http://127.0.0.1:20128/v1

# Model Vision yang digunakan pada gateway lokal (default: oc/mimo-v2.6-flash-free)
# Nilai ini meng-override setting model di config.yaml
MICROSTOCK_API_MODEL=oc/mimo-v2.6-flash-free


# ------------------------------------------------------------------------------
# 2. SECONDARY API PROVIDER: Cloudflare Workers AI (Automatic Fallback & Multi-Account)
# ------------------------------------------------------------------------------
# Diaktifkan otomatis saat provider utama terkena limit (HTTP 429) atau error.
# Dapatkan Account ID & API Token dari Cloudflare Dashboard:
# - Account ID: Cloudflare Dashboard > Workers & Pages (Overview sebelah kanan)
# - API Token: My Profile > API Tokens > Create Token (Workers AI read/write permission)
#
# Mendukung 3 format konfigurasi akun & token:
#
# A. Single Account (Format Standar):
# MICROSTOCK_CF_ACCOUNT_ID=your_cloudflare_account_id_here
# MICROSTOCK_CF_API_TOKEN=your_cloudflare_api_token_here
#
# B. Multi-Account Format Pasangan (Rekomendasi untuk rotasi akun & limit harian):
# MICROSTOCK_CF_ACCOUNTS=account_id_1:api_token_1,account_id_2:api_token_2
#
# C. Multi-Account Format Paralel:
# MICROSTOCK_CF_ACCOUNT_ID=account_id_1,account_id_2
# MICROSTOCK_CF_API_TOKEN=api_token_1,api_token_2

# Cloudflare Account ID (32 karakter hex)
MICROSTOCK_CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare Workers AI API Token
MICROSTOCK_CF_API_TOKEN=your_cloudflare_api_token_here

# Opsional: Multi-Account Credential Pairs (jika disetel, meng-override format single)
# MICROSTOCK_CF_ACCOUNTS=account_id_1:api_token_1,account_id_2:api_token_2

# Model Vision Cloudflare Workers AI (default: @cf/google/gemma-4-26b-a4b-it)
# Model alternatif: @cf/meta/llama-4-scout-17b-16e-instruct atau @cf/meta/llama-3.2-11b-vision-instruct
MICROSTOCK_CF_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
